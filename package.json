{
  "name": "press",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "fast-check": "^4.10.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "oxlint": "^1.90.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "supabase": "^2.122.0",
    "test-renderer": "~1.2.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "start:op": "eval \"$(op inject -i .env.op | grep -v '^#' | grep . | sed 's/^/export /')\" && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:integration": "node scripts/test-integration.mjs",
    "test:web": "node scripts/test-web.mjs",
    "test:web:update": "node scripts/test-web.mjs --update-snapshots",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "lint:agents": "node scripts/lint-agent-neutrality.mjs",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:status": "supabase migration list --linked",
    "db:lint": "supabase db lint --linked"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ],
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.test\\.ts$"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 87,
        "lines": 94,
        "statements": 93
      }
    },
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcovonly"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
