{
  "expo": {
    "name": "Press",
    "slug": "press-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "press",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C120E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.press.golf"
    },
    "android": {
      "package": "com.press.golf",
      "adaptiveIcon": {
        "backgroundColor": "#0C120E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-system-ui",
        {
          "backgroundColor": "#0C120E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C120E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc673b2e-3a56-4299-aa37-afe8944630e5"
      }
    },
    "owner": "jwh3times"
  }
}
