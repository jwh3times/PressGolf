{
  "expo": {
    "name": "Press",
    "slug": "press-app",
    "version": "1.6.0",
    "orientation": "portrait",
    "scheme": "press",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C120E",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.pressgolf.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.pressgolf.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C120E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#0C120E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C120E"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Press uses your location only when you ask: to give the distance to the green, to save where a green or a new course is when you mark it standing there, to save where your ball lies when you mark it, and to list the nearest courses first when you search for one.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Press doesn't use motion or fitness activity. A location library it includes contains motion code, which Press never turns on."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Press uses the camera only when you scan a scorecard to set up a course. The photos are sent to be read, and Press keeps no copy.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc673b2e-3a56-4299-aa37-afe8944630e5"
      }
    },
    "owner": "jwh3times"
  }
}
