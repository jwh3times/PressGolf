{
  "permissions": {
    "allow": [
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project view *)",
      "Bash(gh label list *)",
      "Bash(npm run lint:agents)",
      "Bash(npm run -s lint:agents)",
      "Bash(npm run sync:agents:check)",
      "Bash(npm run -s sync:agents:check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bash(nslookup *)",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id"
    ],
    "ask": [
      "mcp__expo__build_run",
      "mcp__expo__build_submit",
      "mcp__expo__build_cancel",
      "mcp__expo__workflow_run",
      "mcp__expo__workflow_cancel",
      "mcp__expo__sandbox_create",
      "mcp__expo__sandbox_exec",
      "mcp__expo__sandbox_write_stdin",
      "mcp__expo__sandbox_stop",
      "mcp__expo__sandbox_artifact_create",
      "mcp__expo__simulator_start",
      "mcp__expo__simulator_stop",
      "mcp__expo__appstore_reply_review",
      "mcp__expo__appstore_delete_review_response",
      "mcp__expo__playstore_reply_review",
      "mcp__expo__usage_budget_create"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/guard.mjs", "--post"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
