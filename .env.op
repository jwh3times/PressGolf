# Secret references, not secrets. `op run` resolves these out of the
# PressGolf 1Password vault at launch, so no key is ever written into the
# working tree:
#
#     npm run start:op
#
# Both are EXPO_PUBLIC_, so they are compiled into the app bundle and are
# not secret from anyone holding the build. The anon key is meant to be
# public — row-level security is what actually guards the data. This keeps
# them out of git and gives one source of truth, nothing more.
EXPO_PUBLIC_SUPABASE_URL=op://PressGolf/Supabase/url
EXPO_PUBLIC_SUPABASE_ANON_KEY=op://PressGolf/Supabase/anon_key
